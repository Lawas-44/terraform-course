<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ web_titulo }}</title>
  <link rel="stylesheet" href="/estilo.css">
</head>
<body>
<main>
  <h1>{{ web_nombre }}</h1>
  <p>{{ web_descripcion }}</p>

  <h2>Proyectos</h2>
  <ul class="proyectos">
{% for proyecto in web_proyectos %}
    <li><strong>{{ proyecto.nombre }}</strong>{{ proyecto.descripcion }}</li>
{% endfor %}
  </ul>

  <footer>
    Servido por <code>{{ inventory_hostname }}</code>.
    <a href="/estado.html">Estado del servidor</a> · <a href="/privado/">Zona privada</a>
  </footer>
</main>
</body>
</html>
